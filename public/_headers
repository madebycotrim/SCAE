/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  # Removemos o Cross-Origin-Opener-Policy restritivo para permitir o fluxo de Auth
  Cross-Origin-Opener-Policy: unsafe-none
  # Garante que as páginas HTML e rotas SPA não sejam cacheadas pelo navegador (apenas pelo Service Worker)
  Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate
  Pragma: no-cache
  Expires: 0

# Assets são cacheados permanentemente (possuem hash no nome do arquivo)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

# Arquivos na raiz do public se precisarem
/logo.png
  Cache-Control: public, max-age=86400

/firebase-messaging-sw.js
  Cache-Control: no-store, no-cache
