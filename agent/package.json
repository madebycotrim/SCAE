{
  "name": "scae-agent",
  "version": "1.1.0",
  "description": "Agente local SCAE - Comunicação Modular de Hardware",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "tsc && electron dist/main/main.js",
    "build": "tsc",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.5",
    "@types/node-cron": "^3.0.11",
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "br.gov.df.scae.agent",
    "productName": "SCAE Agent",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
